# Normalize text files to LF in the repo; check out native on each OS.
* text=auto

# Windows scripts must stay CRLF so they run correctly on Windows.
*.ps1 text eol=crlf
*.vbs text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary (no line-ending translation).
*.png binary
*.jpg binary
*.gif binary
*.ico binary
