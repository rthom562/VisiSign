# VisiSign — cloud / container configuration.
#
#   cp .env.cloud.example .env     and fill in the secrets
#
# On a managed platform (Cloud Run, App Runner, ECS) you set these as the
# service's environment variables instead of shipping a file, and you put the
# secret ones in Secret Manager / SSM rather than in plain environment values.
#
# Only four are genuinely required in production: DATABASE_URL, JWT_SECRET,
# CORS_ORIGINS and VISISIGN_TZ. The app refuses to boot without the first three
# and will quietly measure the business day in UTC without the fourth.

# ── Required ─────────────────────────────────────────────────────────────────

# Selecting Postgres is just a matter of setting this. Formats:
#   Generic            postgres://user:password@host:5432/visisign
#   Cloud SQL (socket) postgres://user:password@/visisign?host=/cloudsql/PROJECT:REGION:INSTANCE
#   RDS                postgres://user:password@mydb.abc123.us-east-1.rds.amazonaws.com:5432/visisign
DATABASE_URL=postgres://visisign:CHANGE_ME@db:5432/visisign

# Signs session tokens. Generate with:  openssl rand -hex 32
# Changing it logs everyone out, which is the right move if it ever leaks.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Which origins may call the API. "*" is refused in production.
CORS_ORIGINS=https://visisign.example.com

# The timezone the business day is measured in — reservation dates, time slots
# and the end-of-day auto-signout cutoff. A container runs in UTC, so without
# this "sign everyone out at 17:00" fires at 5pm UTC.
VISISIGN_TZ=America/New_York

# ── Postgres tuning ──────────────────────────────────────────────────────────

# TLS to the database. Defaults to on for a remote host and off for localhost,
# a container hostname, or a Cloud SQL unix socket — set it explicitly to be sure.
# PG_SSL=true

# Connections per instance. Keep instances x PG_POOL_MAX under the database's
# max_connections (Cloud SQL db-f1-micro and RDS t4g.micro are both low).
# PG_POOL_MAX=10

# ── Visitor photos ───────────────────────────────────────────────────────────
# A container filesystem is wiped on deploy and is not shared between instances,
# so anything running more than one instance needs object storage here.
#
#   local  a folder under APP_DIR  (single instance with a volume)
#   s3     S3, or any S3-compatible service via S3_ENDPOINT
#   gcs    Google Cloud Storage
#
# Credentials are NOT set here: the SDKs read the instance's own IAM role
# (Cloud Run service account, ECS task role), which is what you want.
STORAGE_DRIVER=local
# PHOTOS_BUCKET=my-visisign-photos
# PHOTOS_PREFIX=photos/
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com   # R2/MinIO only

# ── Badge printing ───────────────────────────────────────────────────────────
# iPad AirPrint and Android Mopria printing need NOTHING here — the tablet
# prints the badge itself from the browser. Set the kiosk's `badge_print_mode`
# setting to `device` in Admin and it works straight from the cloud.
#
# A real label printer at reception (Brother QL, DYMO, Zebra) needs the
# on-premise print agent, because no cloud server can reach a USB printer. Set a
# long shared secret here and give the same value to the agent.
#   openssl rand -hex 32
# PRINT_AGENT_TOKEN=

# How long before a job an agent claimed but never finished goes back on the
# queue (its PC slept, lost network, or the printer jammed).
# PRINT_STALE_SECONDS=180

# Force a transport. Defaults to `direct` on Windows outside a container and
# `queue` everywhere else, which is almost always right.
# PRINT_TRANSPORT=queue

# ── First-run administrator ──────────────────────────────────────────────────
# Used by `node server.js --seed`. Seeding in production REFUSES to create the
# old root/root default, so set a real password before the first seed.
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=

# ── Rarely needed ────────────────────────────────────────────────────────────

# Proxy hops to trust for client IPs and rate limiting. Cloud Run, an ALB and
# App Runner each add exactly one, which is the default.
# TRUST_PROXY=1

# Serve the dashboard from this process. Turn off only if the frontend is hosted
# separately (a CDN or static bucket) and this is an API-only service.
# SERVE_FRONTEND=true

# Run the background jobs (end-of-day sweep, stale print-job requeue). Leave on:
# instances coordinate with a database advisory lock, so the work happens once
# however many are running.
# ENABLE_SCHEDULER=true

# Where writable state lives inside the container.
# APP_DIR=/data

# ── docker-compose only ──────────────────────────────────────────────────────
# Used by docker-compose.yml to create its bundled Postgres. Ignored by a
# managed deployment, where DATABASE_URL points at the provider's database.
POSTGRES_DB=visisign
POSTGRES_USER=visisign
POSTGRES_PASSWORD=CHANGE_ME
APP_PORT=4000
