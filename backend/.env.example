# Copy to .env and adjust. Never commit the real .env.

# Server
PORT=4000
NODE_ENV=development

# Auth — CHANGE THIS in production to a long random string
JWT_SECRET=dev-only-change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# CORS — comma separated list of allowed dashboard origins.
# Use * only in development. In production set the real dashboard URL(s).
CORS_ORIGINS=*

# Database file (relative to /backend)
DB_FILE=visisign.db

# Serve the /frontend folder from the API (handy in dev). Set false to fully
# separate the two layers (deploy frontend elsewhere).
SERVE_FRONTEND=true
